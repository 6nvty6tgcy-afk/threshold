{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threshold",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: required to fetch OAuth Client ID Metadata Documents safely.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Database and KV namespace are created for you on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "threshold","database_id": "03f2137a-aefa-48bd-b8e5-a43ce8e141b7" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV","id": "416da81a33224c4ca1e03c10928abe5b" }],
  // Refresh recent days, backfill history, and decode FIT files in small steps.
  "triggers": { "crons": ["*/10 * * * *"] },
  // Keep settings you change in the dashboard (TIMEZONE, PLAN, ...) when a new version deploys.
  "keep_vars": true,
  // The Deploy to Cloudflare button asks for these when you deploy.
  "secrets": { "required": ["GARMIN_API_KEY", "ACCESS_KEY"] }
}
